# /etc/dispatch/<team>.env - secrets only; chmod 600. Never put these in the YAML file.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# Fine-grained GitHub token limited to this team's repositories, with Contents: read and write and
# Pull requests: read and write (Dispatch pushes dispatch/<task> branches and opens draft PRs).
# Without it, git and gh use the dispatch-<team> user's own credentials.
GH_TOKEN=
