{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings"],
  "properties": {
    "verdict": {"type": "string", "enum": ["ok", "changes"]},
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "text"],
        "properties": {
          "severity": {"type": "string", "enum": ["blocking", "minor"]},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "text": {"type": "string", "maxLength": 500}
        }
      }
    }
  }
}
